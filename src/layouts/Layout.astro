---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Amido is an AI food diary for everyday nutrition. Describe a meal — or scan a photo or barcode — and it estimates ingredients, calories, carbs, protein, fat, fiber and an educational glycemic-load estimate.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/amido-icon.png', Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Amido',
  url: 'https://amido.viglianisi.eu',
  email: 'emavgl.app@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Altenbauerstraße 12',
    postalCode: '4060',
    addressLocality: 'Leonding',
    addressCountry: 'AT',
  },
  logo: ogImageURL.toString(),
  sameAs: ['https://github.com/emavgl/amido-website'],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Amido',
  description,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: ['Android', 'iOS', 'Web'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

const schemas = [softwareSchema, organizationSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Amido, AI food diary, calorie tracker, meal logger, nutrition, carbs, protein, fiber, estimated glycemic load, food diary, meal photo, barcode scan"
    />
    <meta name="author" content="Amido" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f7a3f" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Amido — AI food logger" />
    <meta property="og:site_name" content="Amido" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-white text-gray-900 antialiased flex flex-col min-h-screen">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
