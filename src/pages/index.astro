---
import Layout from '../layouts/Layout.astro';

const title = 'Tippy — AI food logger for type 1 diabetes';
const description =
  'Describe a meal — or scan a photo or barcode — and Tippy estimates ingredients, calories, carbs, protein, fat, fiber and glycemic impact. A food diary built for carbohydrate counting.';

const features = [
  {
    title: 'Chat-first logging',
    body: 'Type “a bowl of pasta with tomato sauce” and Tippy breaks it into ingredients with quantities, calories and macros.',
  },
  {
    title: 'Photo & barcode',
    body: 'Snap a plate the AI can read, or scan a product barcode to pull nutrition straight from Open Food Facts.',
  },
  {
    title: 'Carbs first',
    body: 'Carbohydrates, net carbs, fiber and glycemic load — the numbers that matter for carbohydrate counting.',
  },
  {
    title: 'Edit every detail',
    body: 'Adjust a quantity, drop an ingredient, search or re-scan — the diary totals update as you go.',
  },
  {
    title: 'Your diary',
    body: 'A daily log of meals with running totals per day, and the facts you choose to track.',
  },
  {
    title: 'Nightscout, optional',
    body: 'Write meals to your own Nightscout from the device. Your URL and token never reach our servers.',
  },
];

const steps = [
  { n: '1', title: 'Describe or scan', body: 'Tell Tippy what you ate, or use a photo or barcode.' },
  { n: '2', title: 'Check the ingredients', body: 'Review and edit ingredients, quantities and nutrition facts.' },
  { n: '3', title: 'Save to the diary', body: 'Add it to the log and see the day’s running totals.' },
];
---

<Layout title={title} description={description}>
  <section class="bg-brand-soft">
    <div class="container mx-auto px-6 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <img src="/tippy-icon.png" alt="Tippy" class="w-24 h-24 rounded-3xl mx-auto mb-6 shadow-lg" />
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 mb-4">
          Food logging that counts carbs
        </h1>
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed mb-8">
          Tippy is an AI food logger for people with type 1 diabetes. Describe a meal in
          words — or scan a photo or barcode — and it estimates ingredients, calories,
          carbs and glycemic impact.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            class="px-6 py-3 rounded-xl bg-brand hover:bg-brand-dark text-white font-semibold transition-colors shadow-md"
          >
            Open the app
          </button>
          <button
            type="button"
            class="px-6 py-3 rounded-xl bg-white hover:bg-gray-50 text-gray-900 font-semibold border border-gray-200 transition-colors shadow-xs"
          >
            Support
          </button>
        </div>
        <p class="text-sm text-gray-500 mt-6">
          Estimates only. Tippy is not a medical device — always verify before acting on it.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">What it does</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f) => (
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{f.title}</h3>
              <p class="text-gray-600 leading-relaxed">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">How it works</h2>
        <div class="grid sm:grid-cols-3 gap-6">
          {steps.map((s) => (
            <div class="text-center">
              <div class="w-12 h-12 rounded-full bg-brand text-white font-bold text-xl flex items-center justify-center mx-auto mb-4">
                {s.n}
              </div>
              <h3 class="font-semibold text-gray-900 mb-2">{s.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto bg-amber-50 border border-amber-200 rounded-2xl p-6 md:p-8 text-amber-900">
        <h2 class="text-xl font-bold mb-2">Please read</h2>
        <p class="leading-relaxed">
          Tippy provides information only and is <strong>not</strong> medical or nutritional
          advice. Estimates come from automated systems and public food databases and may be
          inaccurate. Always double-check ingredients, quantities and carbohydrates against a
          product label or another authoritative source before relying on them — especially for
          carbohydrate counting or any dietary or medical decision.
        </p>
      </div>
    </div>
  </section>
</Layout>
